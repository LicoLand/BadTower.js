{
  "name": "badtower-js",
  "version": "0.0.0-preview.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Open-source invitation-gated opaque relay for Cloudflare Workers with SQLite-backed Durable Objects.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "check:scripts": "node --check scripts/station.mjs && sh -n scripts/container-entrypoint.sh",
    "check:generated": "wrangler types worker-configuration.d.ts --check -c wrangler.jsonc",
    "test": "vitest run",
    "test:workers": "vitest run --project workers",
    "test:node": "vitest run --project node",
    "station": "node scripts/station.mjs",
    "container:up": "docker compose up --build -d",
    "container:down": "docker compose down",
    "dryrun": "wrangler deploy --dry-run",
    "check": "npm run typecheck && npm run check:scripts && npm run check:generated && npm run test && npm run dryrun"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.2",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
