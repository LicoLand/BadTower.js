{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badtower",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false, "logs": { "enabled": false } },
  "secrets": { "required": ["BADTOWER_STATION_KEY", "BADTOWER_METRICS_KEY"] },
  "vars": {
    "BADTOWER_PLAN": "free",
    "BADTOWER_MAILBOX_CAPACITY_BYTES": "1000000000",
    "BADTOWER_ALLOW_PLAINTEXT": "false"
  },
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] }]
}
