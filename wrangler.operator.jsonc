{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badtower-operator",
  "main": "src/operator-entry.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "operator.badtower.invalid", "custom_domain": true }],
  "vars": {
    "BADTOWER_RUNTIME_MODE": "production",
    "BADTOWER_EDGE_AUTHORIZATION": "mtls"
  },
  "secrets": {
    "required": [
      "BADTOWER_OPERATOR_TOKEN_DIGEST",
      "BADTOWER_CAPABILITY_KEYS"
    ]
  },
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "durable_objects": {
    "bindings": [
      { "name": "ACCESS_GRANTS", "class_name": "AccessGrant", "script_name": "badtower-data" }
    ]
  },
  "ratelimits": [
    { "name": "SENSITIVE_RATE_LIMITER", "namespace_id": "420004", "simple": { "limit": 120, "period": 60 } }
  ]
}
